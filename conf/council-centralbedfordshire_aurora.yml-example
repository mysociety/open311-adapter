oauth:
  username: username
  password: password
  client_id: client_id
  client_secret: secret
  access_token_url: url

cases_api_base_url: url
updates_azure_container_base_url: url
updates_azure_container_url_arguments: sas_token

# A map from 'ClearanceReasonCode' to update status.
reverse_status_mapping:
  DR01: in_progress
  DR02: closed

# Optional. A map from the Aurora trigger an update file was written for to
# update status. If set, only these triggers and CS_CLEAR_CASE (which always
# uses reverse_status_mapping) produce updates, and the trigger name is sent
# as the external status code. If not set, a fixed set of triggers is used.
#trigger_status_mapping:
#  CS_CHANGE_QUEUE: open
#  CS_INSPECTION_PROMPTED: investigating
#  CS_MAINTENANCE_COMPLETED: fixed

# Optional. The status for CS_CLEAR_CASE updates whose clearance code is not
# in reverse_status_mapping, so their text is still passed on. Only applies
# to updates that have text. If not set, such updates are skipped.
#unmapped_clearance_status: unchanged

# A map from service_code to:
#
#   name: The display name for the category
#   group: Optional category group
#   parameters: dictionary of default parameters to use
category_mapping:
  categoryA:
    name: "Category A"
    group: "Group 1"
    parameters:
      caseTypeCode: Code
  categoryB:
    name: "Category B"
    parameters:
      caseTypeCode: Code
